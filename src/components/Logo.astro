---
/* The site's brand mark: twin focus brackets take `currentColor` (`text-brand`)
   while the shared focal core takes the agent signal accent unless `mono` is set. */
import { logo } from "./logo";

interface Props {
	class?: string;
	mono?: boolean;
}

const { class: cls = "h-5 w-5", mono = false } = Astro.props;
const coreFill = mono ? "currentColor" : "var(--color-agent, #ff893b)";
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${logo.width} ${logo.height}`} class={cls} aria-hidden="true">
	{logo.brackets.map((d) => <path d={d} fill="currentColor" fill-rule="evenodd" />)}
	<path d={logo.core} fill={coreFill} />
</svg>
